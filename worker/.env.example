# Copy to .env for local runs, or paste these into Railway's Variables tab.
# NEVER commit the real .env — it is gitignored.

# Storage (both required) — from upstash.com after creating a Redis database
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Provider keys (any subset works; a missing key skips that racer)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Race tuning (optional)
FEATURED_PROBLEM=Riemann
FEATURED_WEIGHT=0.7
RACE_INTERVAL_MS=3600000        # 1 hour per model = ~$5-7/day; 600000 = 10 min = ~$30-40/day

# Model overrides (optional; verified defaults: claude-opus-4-8, gpt-5, grok-4.5)
#ANTHROPIC_MODEL=claude-haiku-4-5   # budget mode
#OPENAI_MODEL=gpt-5-mini            # budget mode
#XAI_MODEL=grok-4.3                 # budget mode
